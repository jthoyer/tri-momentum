# Copy to .env.local and fill in your own values. Never commit .env.local.

# Settings > Developer Settings on intervals.icu (near the bottom of the page)
INTERVALS_API_KEY=

# "0" means "the athlete who owns the API key above". Only set this to a
# specific id (e.g. i123456, from your intervals.icu profile URL) if you're
# ever looking at a different athlete than the key belongs to.
INTERVALS_ATHLETE_ID=0
